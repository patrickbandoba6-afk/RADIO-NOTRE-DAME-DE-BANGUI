# ==========================================================================
# RADIO NOTRE-DAME DE BANGUI — variables d'environnement
# Copiez ce fichier en `.env` puis renseignez vos valeurs.
# Toutes les variables exposées à l'application doivent commencer par
# EXPO_PUBLIC_ (contrainte Expo).
# ==========================================================================

# --- Flux radio en direct --------------------------------------------------
# Flux vérifié le 10/09/2026 depuis https://radionotredame.caster.fm/
# (Caster Streaming Server 2.3, compatible Icecast/Shoutcast, MP3 128 kbps).
# Laisser vide pour utiliser cette valeur par défaut.
EXPO_PUBLIC_RADIO_STREAM_URL=http://shaincast.caster.fm:16045/listen.mp3

# Jeton d'écoute Caster.fm, ajouté en paramètre d'URL si la station l'exige.
# Exemple : authnfe41f0eb2c9a81d1d9e8296511afbdf2
EXPO_PUBLIC_RADIO_STREAM_AUTH=

# Flux de secours, essayé automatiquement si le flux principal tombe.
EXPO_PUBLIC_RADIO_STREAM_BACKUP_URL=

# SHOUTCAST | ICECAST | HLS | MP3 | AAC | AACP
EXPO_PUBLIC_RADIO_STREAM_TYPE=SHOUTCAST
EXPO_PUBLIC_RADIO_STREAM_CODEC=MP3
EXPO_PUBLIC_RADIO_STREAM_BITRATE=128

# Endpoint d'état du serveur (titre en cours, nombre d'auditeurs).
EXPO_PUBLIC_RADIO_STATUS_URL=http://shaincast.caster.fm:16045/status-json.xsl

# --- Coordonnées de la station (À CONFIGURER par la radio) ----------------
# Laisser vide tant que l'information n'est pas confirmée : l'application
# masque automatiquement les champs non renseignés.
EXPO_PUBLIC_RADIO_TELEPHONE=
EXPO_PUBLIC_RADIO_EMAIL=
EXPO_PUBLIC_RADIO_ADRESSE=
EXPO_PUBLIC_RADIO_SITE=
EXPO_PUBLIC_RADIO_FACEBOOK=

# --- Direct vidéo (facultatif) --------------------------------------------
EXPO_PUBLIC_VIDEO_LIVE_URL=

# --- Backend Supabase ------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Paiements (facultatif) ------------------------------------------------
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Dons : paiement manuel (Mobile Money / virement) ----------------------
# Laisser vide tant que l'information n'est pas confirmée par la radio.
EXPO_PUBLIC_DONS_ORANGE_USSD=
EXPO_PUBLIC_DONS_ORANGE_CODE_MARCHAND=
EXPO_PUBLIC_DONS_ORANGE_NUMERO=
EXPO_PUBLIC_DONS_BANQUE_NOM=
EXPO_PUBLIC_DONS_BANQUE_COMPTE=

# --- Espace administrateur (back-office intégré en WebView) ---------------
# URL du back-office une fois déployé en ligne (voir admin/).
EXPO_PUBLIC_ADMIN_URL=
