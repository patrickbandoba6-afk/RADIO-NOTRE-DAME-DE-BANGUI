# Copiez ce fichier en .env et remplissez les valeurs réelles.
# L'application fonctionne aussi sans ces valeurs (données d'exemple locales).

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Flux radio en direct (URL de streaming Icecast/HLS)
EXPO_PUBLIC_RADIO_STREAM_URL=https://ice1.somafm.com/gaydio-128-mp3

# Flux vidéo en direct (HLS) pour les messes/cultes retransmis
EXPO_PUBLIC_VIDEO_LIVE_URL=

# Passerelle de paiement (Stripe) pour les dons
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
