# Back-office Radio Notre-Dame de Bangui
# Copiez ce fichier en `.env.local` puis renseignez les valeurs de votre
# projet Supabase (Settings → API). Ce sont les MÊMES valeurs que celles
# utilisées par l'application mobile.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète (service_role, Settings → API). SERVEUR UNIQUEMENT — ne jamais
# la préfixer par NEXT_PUBLIC_. Nécessaire pour la page /equipe (invitations
# et attribution des rôles).
SUPABASE_SERVICE_ROLE_KEY=
